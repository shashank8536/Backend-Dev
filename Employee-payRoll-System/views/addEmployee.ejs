<!DOCTYPE html>
<html>
<head>
  <title>Add Employee</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    .avatar-option img {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      cursor: pointer;
      border: 2px solid transparent;
    }

    .avatar-option input:checked + img {
      border: 3px solid #198754;
    }

    .form-card {
      max-width: 800px;
      margin: auto;
    }
  </style>
</head>
<body class="bg-light">

<div class="container mt-5">
  <div class="card shadow p-4 form-card">
    <h4 class="mb-4">Employee Payroll Form</h4>

    <form action="/api/employees" method="POST">

      <!-- Name -->
      <div class="mb-3">
        <label class="form-label">Name</label>
        <input class="form-control" name="name" required>
      </div>

      <!-- Profile Image -->
      <div class="mb-3">
        <label class="form-label">Profile Image</label><br>

        <% const avatars = [
          "https://randomuser.me/api/portraits/women/1.jpg",
          "https://randomuser.me/api/portraits/men/2.jpg",
          "https://randomuser.me/api/portraits/women/3.jpg",
          "https://randomuser.me/api/portraits/men/4.jpg"
        ]; %>

        <% avatars.forEach(img => { %>
          <label class="avatar-option me-3">
            <input type="radio" name="profileImage" value="<%= img %>" hidden required>
            <img src="<%= img %>">
          </label>
        <% }) %>
      </div>

      <!-- Gender -->
      <div class="mb-3">
        <label class="form-label">Gender</label><br>
        <input type="radio" name="gender" value="male" required> Male
        <input type="radio" name="gender" value="female" class="ms-3"> Female
      </div>

      <!-- Department -->
      <div class="mb-3">
        <label class="form-label">Department</label><br>
        <% ["HR","Sales","Finance","Engineer","Others"].forEach(dep => { %>
          <input type="checkbox" name="department" value="<%= dep %>"> <%= dep %>
        <% }) %>
      </div>

      <!-- Salary -->
      <div class="mb-3">
        <label class="form-label">Salary</label>
        <select name="basicSalary" class="form-select" required>
          <option value="">Select Salary</option>
          <option value="10000">10,000</option>
          <option value="20000">20,000</option>
          <option value="50000">50,000</option>
          <option value="100000">100,000</option>
        </select>
      </div>

<!-- Start Date -->
<div class="mb-3">
  <label class="form-label">Start Date</label>
  <input type="date" name="joiningDate" class="form-control" required>

      <!-- Notes -->
      <div class="mb-3">
        <label class="form-label">Notes</label>
        <textarea name="notes" class="form-control"></textarea>
      </div>

      <div class="text-center">
        <a href="/" class="btn btn-secondary">Cancel</a>
        <button class="btn btn-success">Submit</button>
        <button type="reset" class="btn btn-light">Reset</button>
      </div>

    </form>
  </div>
</div>

</body>
</html>
