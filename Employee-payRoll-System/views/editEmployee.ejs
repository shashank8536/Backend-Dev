<!DOCTYPE html>
<html>
<head>
  <title>Edit Employee</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

<div class="container mt-5">
  <div class="card shadow p-4" style="max-width:700px;margin:auto;">
    <h4 class="mb-4">Edit Employee</h4>

    <form action="/edit/<%= employee._id %>?_method=PUT" method="POST">
      <div class="mb-3">
        <label>Name</label>
        <input class="form-control" name="name" value="<%= employee.name %>" required>
      </div>

      <div class="mb-3">
        <label>Gender</label><br>
        <input type="radio" name="gender" value="male"
          <%= employee.gender === "male" ? "checked" : "" %>> Male

        <input type="radio" name="gender" value="female"
          class="ms-3"
          <%= employee.gender === "female" ? "checked" : "" %>> Female
      </div>

      <div class="mb-3">
        <label>Department</label><br>
        <% ["HR","Sales","Finance","Engineer","Others"].forEach(dep => { %>
          <input type="checkbox" name="department" value="<%= dep %>"
            <%= employee.department.includes(dep) ? "checked" : "" %>>
          <%= dep %>
        <% }) %>
      </div>

      <div class="mb-3">
        <label>Salary</label>
        <input class="form-control" name="basicSalary" value="<%= employee.basicSalary %>" required>
      </div>

      <div class="mb-3">
        <label>Start Date</label>
        <input type="date" name="joiningDate"
          class="form-control"
          value="<%= employee.joiningDate.toISOString().split('T')[0] %>"
          required>
      </div>

      <div class="text-center">
        <a href="/" class="btn btn-secondary">Cancel</a>
        <button class="btn btn-success">Update</button>
      </div>

    </form>
  </div>
</div>

</body>
</html>
